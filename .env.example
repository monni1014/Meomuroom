# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Prisma database URL connections for the SQLite database.
DATABASE_URL="file:./dev.db"

# IPRoyal residential/mobile proxy for RPA.
IPROYAL_PROXY_HOST="host from IPRoyal"
IPROYAL_PROXY_PORT="port from IPRoyal"
IPROYAL_PROXY_PROTOCOL="http"
IPROYAL_PROXY_USER="username from IPRoyal"
IPROYAL_PROXY_PASS="password from IPRoyal"
IPROYAL_API_TOKEN="API token from IPRoyal dashboard settings"
IPROYAL_TRAFFIC_WARNING_GB="0.2"
IPROYAL_TRAFFIC_CRITICAL_GB="0.05"

# SOLAPI notifications
SOLAPI_API_KEY="API key from Solapi"
SOLAPI_API_SECRET="API secret from Solapi"
SOLAPI_FROM="registered sender phone number without hyphen"
OWNER_PHONE="owner/test recipient phone number without hyphen"
SOLAPI_TEST_TO="test recipient phone number without hyphen"
SOLAPI_REAL_SEND="false"
SOLAPI_MESSAGE_CHANNEL="SMS"
SOLAPI_KAKAO_PFID=""
SOLAPI_KAKAO_RESERVATION_TEMPLATE_ID=""
SOLAPI_SENDER_RENEWAL_DATE=""
MEMOROOM_ROOM1_GUIDE="Room 1 안내문"
MEMOROOM_ROOM2_GUIDE="Room 2 안내문"
MEMOROOM_ROOM3_GUIDE="Room 3 안내문"
ADMIN_ALERT_WEBHOOK_URL=""
RPA_HEADLESS="false"
RPA_MIN_DELAY_MS="900"
RPA_MAX_DELAY_MS="2200"

# Optional RPA test URLs.
NAVER_PARTNER_HOME_URL="https://partner.booking.naver.com/"
NAVER_BIZ_ITEMS_URL="https://partner.booking.naver.com/bizes/1473933/biz-items"
NAVER_ROOM1_PRODUCT_URL=""
NAVER_ROOM2_PRODUCT_URL=""
NAVER_BOOKING_DETAIL_URL="https://partner.booking.naver.com/bizes/1473933/booking-list-view/bookings/BOOKING_ID"

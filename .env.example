# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=http://localhost:3000

# DATABASE_URL: Prisma database URL connections for the SQLite database.
DATABASE_URL=file:./dev.db

# RPA is denied by default. Set true only on the single authorized server.
RPA_EXECUTION_ENABLED="false"
DISABLE_BACKGROUND_JOBS="1"

# Fixed proxy used by every RPA provider. Legacy IPROYAL_PROXY_* values remain supported.
RPA_PROXY_PROVIDER="proxyseller"
RPA_PROXY_HOST=
RPA_PROXY_PORT=
RPA_PROXY_PROTOCOL="http"
RPA_PROXY_USER=
RPA_PROXY_PASS=
RPA_USE_PROXY="true"
RPA_PROXY_DIRECT_FALLBACK="false"
PROXYSELLER_API_KEY=

# Legacy IPRoyal traffic-based fallback settings.
IPROYAL_PROXY_DIRECT_FALLBACK_GB="0.01"
IPROYAL_API_TOKEN=
IPROYAL_TRAFFIC_WARNING_GB="0.2"
IPROYAL_TRAFFIC_CRITICAL_GB="0.05"

# SOLAPI notifications
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
OWNER_PHONE=
SOLAPI_TEST_TO=
SOLAPI_REAL_SEND="false"
# Optional comma-separated burn-in allowlist. Empty means every valid recipient when SOLAPI_REAL_SEND=true.
SOLAPI_REAL_SEND_ALLOWLIST=
SOLAPI_SENDER_RENEWAL_DATE=""
MEMOROOM_ROOM1_GUIDE=
MEMOROOM_ROOM2_GUIDE=
MEMOROOM_ROOM3_GUIDE=
ADMIN_ALERT_WEBHOOK_URL=
SOLAPI_WEBHOOK_SECRET=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Google People contact sync (wife's Google account)
GOOGLE_PEOPLE_CREDENTIALS_PATH="/srv/memoroom/shared/google-people-credentials.json"
GOOGLE_PEOPLE_TOKEN_PATH="/srv/memoroom/shared/google-people-token.json"
RPA_HEADLESS="false"
RPA_MIN_DELAY_MS="900"
RPA_MAX_DELAY_MS="2200"
COMPETITOR_SYNERGY_LEAD_MINUTES="120"
COMPETITOR_TRIGROUND_LEAD_MINUTES="0"
COMPETITOR_CUTOFF_STUDY_ENABLED="false"
COMPETITOR_CUTOFF_STUDY_UNTIL=""

# Optional RPA test URLs.
NAVER_PARTNER_HOME_URL=
NAVER_BIZ_ITEMS_URL=
NAVER_ROOM1_PRODUCT_URL=
NAVER_ROOM2_PRODUCT_URL=
NAVER_BOOKING_DETAIL_URL=

[Unit]
Description=Safely reclaim Memoroom RPA browser memory
After=network-online.target memoroom-app.service memoroom-rpa-browser@naver.service memoroom-rpa-browser@spacecloud.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/memoroom-memory-optimization
TimeoutStartSec=4min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/memoroom/shared /srv/memoroom/app/rpa /srv/memoroom/.cache /srv/memoroom/.config /srv/memoroom/.local

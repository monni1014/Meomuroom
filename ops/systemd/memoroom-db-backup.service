[Unit]
Description=Memoroom encrypted SQLite backup to Google Drive
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=TZ=Asia/Seoul
ExecStart=/usr/local/sbin/memoroom-db-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/memoroom /root/.config/rclone /run/lock

[Install]
WantedBy=multi-user.target

[Unit]
Description=Memoroom SpaceCloud automatic session renewal
After=network-online.target memoroom-app.service
Wants=network-online.target

[Service]
Type=oneshot
User=memoroom
Group=memoroom
WorkingDirectory=/srv/memoroom/app
Environment=NODE_ENV=production
Environment=TZ=Asia/Seoul
Environment=HOME=/srv/memoroom
Environment=XDG_CONFIG_HOME=/srv/memoroom/.config
Environment=XDG_CACHE_HOME=/srv/memoroom/.cache
Environment=PLAYWRIGHT_BROWSERS_PATH=/srv/memoroom/.cache/ms-playwright
Environment=RPA_EXECUTION_ENABLED=true
ExecStart=/usr/bin/node /srv/memoroom/app/rpa/spacecloud-login-auto.mjs
TimeoutStartSec=10m
TimeoutStopSec=45
KillMode=control-group
SendSIGKILL=true
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/memoroom/app/rpa/.locks /srv/memoroom/app/rpa/.runtime /srv/memoroom/app/rpa/screenshots /srv/memoroom/shared

[Install]
WantedBy=multi-user.target

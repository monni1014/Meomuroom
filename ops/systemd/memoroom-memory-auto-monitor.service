[Unit]
Description=Monitor Memoroom RAM and request safe automatic cleanup
After=network-online.target memoroom-app.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=MEMOROOM_MEMORY_AUTO_THRESHOLD_PERCENT=75
Environment=MEMOROOM_MEMORY_AUTO_HOLD_SECONDS=600
Environment=MEMOROOM_MEMORY_AUTO_COOLDOWN_SECONDS=21600
ExecStart=/usr/bin/node /srv/memoroom/app/ops/scripts/memoroom-memory-auto-monitor.mjs
TimeoutStartSec=30s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/memoroom/shared

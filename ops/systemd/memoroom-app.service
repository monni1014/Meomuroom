[Unit]
Description=Memoroom Next.js application and reservation workers
After=network-online.target memoroom-rpa-browser@naver.service memoroom-rpa-browser@spacecloud.service
Wants=network-online.target memoroom-rpa-browser@naver.service memoroom-rpa-browser@spacecloud.service

[Service]
Type=simple
ExitType=cgroup
User=memoroom
Group=memoroom
WorkingDirectory=/srv/memoroom/app
Environment=NODE_ENV=production
Environment=TZ=Asia/Seoul
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOME=/srv/memoroom
Environment=XDG_CONFIG_HOME=/srv/memoroom/.config
Environment=XDG_CACHE_HOME=/srv/memoroom/.cache
Environment=PLAYWRIGHT_BROWSERS_PATH=/srv/memoroom/.cache/ms-playwright
Environment=DISABLE_BACKGROUND_JOBS=0
Environment=RPA_EXECUTION_ENABLED=true
Environment=RPA_HEADLESS=true
Environment=RPA_SHARED_BROWSER_SYSTEMD_MANAGED=true
Environment=SPACECLOUD_RPA_USE_XVFB=true
Environment=SPACECLOUD_RPA_REUSE_BROWSER=true
Environment=MEMOROOM_MEMORY_OPTIMIZATION_ENABLED=true
Environment=MEMOROOM_RPA_MAINTENANCE_LOCK_PATH=/srv/memoroom/shared/rpa-maintenance.lock
ExecStartPre=/usr/bin/rm -f /srv/memoroom/app/rpa/.runtime/browser-host.json /srv/memoroom/app/rpa/.runtime/browser-host-starting.lock
ExecStart=/usr/bin/npm start
ExecStop=/usr/bin/node /srv/memoroom/app/ops/scripts/memoroom-wait-for-rpa-idle.mjs
Restart=always
RestartSec=5
TimeoutStopSec=14min
KillMode=control-group
SendSIGKILL=true
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/memoroom/app /srv/memoroom/shared

[Install]
WantedBy=multi-user.target

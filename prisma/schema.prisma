generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Reservation {
  id                  String    @id @default(cuid())
  source              String // "naver", "spacecloud", "manual"
  roomName            String    @default("머무룸1")
  customerName        String?
  customerType        String    @default("UNSPECIFIED") // "UNSPECIFIED" | "PERSONAL" | "CORPORATE"
  phone               String?
  syncedPhone         String? // 네이버·스클에서 마지막으로 확인한 원본 전화번호
  phoneLocked         Boolean   @default(false) // 캘린더에서 수동 수정한 전화번호는 RPA 재동기화로 덮어쓰지 않음
  startTime           DateTime
  endTime             DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  notifiedAt          DateTime?
  notificationStatus  String    @default("PENDING") // PENDING | SENDING | RECOVERING | SUBMITTED | CARRIER_ACCEPTED | DELIVERED | FAILED | DRY_RUN
  notificationChannel String?
  notificationError   String?
  notified            Boolean   @default(false) // 예약 2시간 전 알림 발송 여부
  price               Int       @default(0) // 최종 매출액 (쿠폰 할인 적용 후)
  discount            Int       @default(0) // 사용한 쿠폰/할인 금액 (원가 - 최종가)
  status              String    @default("CONFIRMED") // "CONFIRMED" | "CANCELLED"
  isNoShow            Boolean   @default(false) // 취소 중에서도 노쇼인 경우 (수수료/집계는 취소와 동일, 표기만 구분)
  paymentMethod       String?   @default("온라인") // "현장카드" | "계좌이체" | "온라인"
  isPaid              Boolean   @default(true) // 결제 완료 여부 (이체 등 미결제는 false)
  emailId             String?   @unique
  memo                String? // 자유 기입 비고란
  complaints          String? // 고객 불만사항 (CS 관리용 별도 항목)
  isCleanUpBad        Boolean   @default(false) // 정리 상태 불량 여부 (블랙리스트 기능)

  usageLog UsageLog?
  messages CustomerMessage[]
}

model ProcessedEmail {
  id            String   @id @default(cuid())
  messageId     String   @unique
  source        String?
  reservationId String?
  createdAt     DateTime @default(now())
}

model ImapSyncCursor {
  mailboxKey  String   @id
  uidValidity String
  lastUid     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PendingImapEmail {
  id           String    @id @default(cuid())
  mailboxKey   String
  uidValidity  String
  uid          Int
  messageId    String    @unique
  rawSource    Bytes
  envelopeDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([mailboxKey, uidValidity, uid])
  @@index([mailboxKey, uid])
  @@index([createdAt])
}

model UsageLog {
  id                 String      @id @default(cuid())
  reservationId      String      @unique
  reservation        Reservation @relation(fields: [reservationId], references: [id])
  headCount          Int         @default(0) // 실제 이용인원 (CCTV 관찰 기준, 분석의 기준값)
  reservedHeadCount  Int         @default(0) // 예약 이용인원 (메일 자동, 플랫폼 최소인원 영향)
  coffeeCount        Int         @default(0)
  purpose            String? // 대분류(고정): 교육/보드게임/사적모임/촬영/회사회의/기타 (null=미입력)
  detail             String? // 세부내용(자유입력): "보험교육", "유튜브 촬영" 등
  extraTime          Int         @default(0) // 추가된 시간 (시간 단위)
  extraPrice         Int? // 확정된 추가 결제 금액
  isExtraPaid        Boolean     @default(false) // 추가 금액 결제 여부
  extraPaymentMethod String? // 추가 금액 결제 수단 (예: 계좌이체, 카드결제)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model ManualTableCell {
  id        String   @id @default(cuid())
  tableId   String
  sectionId String
  year      Int
  month     Int
  day       Int
  cellKey   String
  value     String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tableId, sectionId, year, month, day, cellKey])
  @@index([tableId, sectionId, year, month])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  roomName  String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAlert {
  id          String    @id @default(cuid())
  type        String
  severity    String    @default("WARNING")
  title       String
  message     String
  dedupeKey   String?   @unique
  resolved    Boolean   @default(false)
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([resolved, createdAt])
  @@index([type, createdAt])
}

model SmsBridgeDevice {
  id               String            @id @default(cuid())
  name             String
  phoneNumber      String            @unique
  tokenHash        String            @unique
  externalDeviceId String?           @unique
  platform         String            @default("ANDROID")
  enabled          Boolean           @default(true)
  lastSeenAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         CustomerMessage[]

  @@index([enabled, lastSeenAt])
}

model CustomerMessage {
  id                String           @id @default(cuid())
  direction         String // INBOUND | OUTBOUND
  channel           String           @default("SMS")
  status            String // RECEIVED | SENDING | SUBMITTED | CARRIER_ACCEPTED | DELIVERED | FAILED | DRY_RUN
  senderNumber      String
  recipientNumber   String
  customerPhone     String
  body              String
  providerMessageId String?
  dedupeKey         String           @unique
  reservationId     String?
  reservation       Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  bridgeDeviceId    String?
  bridgeDevice      SmsBridgeDevice? @relation(fields: [bridgeDeviceId], references: [id], onDelete: SetNull)
  occurredAt        DateTime
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerPhone, occurredAt])
  @@index([reservationId, occurredAt])
  @@index([direction, readAt, occurredAt])
}

model ProxyTrafficCheck {
  id          String   @id @default(cuid())
  provider    String   @default("iproyal")
  availableGb Float
  warningGb   Float
  criticalGb  Float
  rawPayload  String?
  checkedAt   DateTime @default(now())

  @@index([provider, checkedAt])
}

model ProxyPayment {
  id          String    @id @default(cuid())
  provider    String    @default("Proxy-Seller")
  paidOn      DateTime
  amountMinor Int
  currency    String    @default("USD") // USD is stored in cents; KRW is stored in won.
  vatIncluded Boolean   @default(true)
  periodStart DateTime?
  periodEnd   DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([paidOn])
  @@index([provider, paidOn])
}

model CompetitorScan {
  id             String    @id @default(cuid())
  mode           String
  status         String    @default("RUNNING") // RUNNING | COMPLETED | PARTIAL | FAILED
  targetStartKey String
  targetEndKey   String
  checkedSlots   Int       @default(0)
  changedSlots   Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([status, startedAt])
  @@index([mode, startedAt])
}

model CompetitorSlot {
  id                   String    @id @default(cuid())
  competitorId         String
  dateKey              String
  hour                 Int
  state                String // AVAILABLE | BOOKED | POLICY_CLOSED | UNKNOWN | NOT_OFFERED
  observedState        String
  firstObservedAt      DateTime  @default(now())
  lastCheckedAt        DateTime  @default(now())
  lastChangedAt        DateTime  @default(now())
  lastBookedAt         DateTime?
  lastReleasedAt       DateTime?
  lastScanId           String?
  pendingState         String?
  pendingCount         Int       @default(0)
  pendingSince         DateTime?
  opportunityLostRooms String?

  @@unique([competitorId, dateKey, hour])
  @@index([competitorId, dateKey])
  @@index([dateKey, state])
}

model CompetitorSlotObservation {
  id             String   @id @default(cuid())
  scanId         String
  competitorId   String
  dateKey        String
  hour           Int
  observedState  String
  effectiveState String
  reason         String?
  checkedAt      DateTime @default(now())

  @@index([scanId])
  @@index([competitorId, dateKey, checkedAt])
}

model CompetitorSlotEvent {
  id                   String    @id @default(cuid())
  scanId               String
  competitorId         String
  dateKey              String
  hour                 Int
  eventType            String // BOOKED | CANCELLED
  previousState        String?
  newState             String
  cancellationFeeRate  Int?
  opportunityLostRooms String?
  occurredAt           DateTime  @default(now())
  acknowledgedAt       DateTime?

  @@index([competitorId, dateKey, occurredAt])
  @@index([eventType, occurredAt])
  @@index([acknowledgedAt, occurredAt])
}

model CompetitorEvidence {
  id           String    @id @default(cuid())
  scanId       String?
  competitorId String
  dateKey      String?
  startHour    Int?
  endHour      Int?
  reasonCode   String
  reason       String
  imagePath    String
  status       String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  capturedAt   DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  resolvedAt   DateTime?
  dismissedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, capturedAt])
  @@index([competitorId, dateKey, capturedAt])
  @@index([scanId])
}
